# MongoDB bağlantı URI'si (zorunlu)
MONGODB_URI=

# Öğretmen paneli şifresi (zorunlu)
TEACHER_PASSWORD=

# Yönetici (audit log) şifresi (zorunlu).
# Set edilmezse TEACHER_PASSWORD'a düşer; üretimde ayrı bir değer öneriyoruz.
ADMIN_PASSWORD=

# Cookie HMAC anahtarı (zorunlu, en az 16 karakter).
# Üret: `openssl rand -hex 32`
SESSION_SECRET=

# /api/cron/archive endpoint'i için bearer token (prod'da zorunlu)
CRON_SECRET=
